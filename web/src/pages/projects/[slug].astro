---
import Layout from "@/layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { getCollection, render, type CollectionEntry } from "astro:content";
import TechList from "@/components/TechList.astro";
import Typewriter from "@/components/Typewriter.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props satisfies Props;
const { Content } = await render(project);
---

<Layout title={project.data.title}>
  <article class="max-w-2xl">
    <Typewriter>
      <h1 class="mb-1 text-2xl font-bold">&gt; {project.data.title}</h1>
    </Typewriter>
    <TechList tech={project.data.tech} className="mb-3 text-md text-muted" />
    <div
      class="prose-sm space-y-3 text-md leading-relaxed text-secondary [&_h1]:font-bold [&_h1]:text-xl [&_h2]:text-lg [&_h2]:font-bold [&_h3]:font-bold [&_li]:list-disc [&_li]:ml-4"
    >
      <Content />
    </div>
    {
      project.data.links && (
        <article class="mt-6 flex flex-col gap-2">
          <h2 class="text-xl font-bold">Links:</h2>
          <ul class="text-md">
            {project.data.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="underline flex items-center gap-1 hover:bg-primary hover:text-secondary"
                >
                  {link.label}
                  {link.label.toLocaleLowerCase() === "github" && (
                    <Icon name="mdi:github" class="text-xl" />
                  )}
                  {link.label.toLocaleLowerCase() === "website" && (
                    <Icon name="mdi:web" class="text-xl" />
                  )}
                </a>
              </li>
            ))}
          </ul>
        </article>
      )
    }
  </article>
</Layout>
