---
import { Icon } from "astro-icon/components";
import Layout from "../layouts/Layout.astro";
import Typewriter from "@/components/Typewriter.astro";
import Link from "@/components/ui/Link";

const liClass = "flex items-center gap-1";
---

<Layout title="contact">
  <Typewriter><h1 class="mb-2 text-2xl font-bold">&gt; contact</h1></Typewriter>
  <ul class="space-y-2 text-md">
    <li class={liClass}>
      <Icon name="mdi:email" class="text-xl" />
      e-mail:
      <Link href="mailto:filip.kasperski@proton.me">
        filip.kasperski@proton.me
      </Link>
    </li>
    <li class={liClass}>
      <Icon name="mdi:github" class="text-xl" />
      github:
      <Link href="https://github.com/pilif139"> pilif139 </Link>
    </li>
    <li class={liClass}>
      <Icon name="mdi:linkedin" class="text-xl" />
      linkedin: <Link href="https://www.linkedin.com/in/filip-kasperski-b80a8b310/">
        Filip Kasperski
      </Link>
    </li>
  </ul>
</Layout>
