---
import { Icon } from "astro-icon/components";
import Layout from "../layouts/Layout.astro";
import Typewriter from "@/components/Typewriter.astro";

const linkClass = {
  li: "flex items-center gap-1",
  a: "underline hover:bg-primary hover:text-secondary",
};
---

<Layout title="Contact">
  <Typewriter><h1 class="mb-2 text-2xl font-bold">&gt; contact</h1></Typewriter>
  <ul class="space-y-2 text-md">
    <li class={linkClass.li}>
      <Icon name="mdi:email" class="text-xl" />
      e-mail:
      <a href="mailto:filip.kasperski@proton.me" class={linkClass.a}>
        filip.kasperski@proton.me
      </a>
    </li>
    <li class={linkClass.li}>
      <Icon name="mdi:github" class="text-xl" />
      github:
      <a href="https://github.com/pilif139" class={linkClass.a}> pilif139 </a>
    </li>
    <li class={linkClass.li}>
      <Icon name="mdi:linkedin" class="text-xl" />
      linkedin: <a
        href="https://www.linkedin.com/in/filip-kasperski-b80a8b310/"
        class={linkClass.a}
      >
        Filip Kasperski
      </a>
    </li>
  </ul>
</Layout>
