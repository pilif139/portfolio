---
import { Icon } from "astro-icon/components";
import Layout from "../layouts/Layout.astro";
import MotionBox from "@/components/ui/MotionBox";
import Link from "@/components/ui/Link";
import { COLORS } from "@/lib/colors";

const liClass = "flex items-center gap-1";
---

<Layout title="contact">
  <MotionBox client:load style={{ backgroundColor: COLORS.teal }} className="inline-block px-3 py-1 my-2">
    <h1 class="text-2xl font-bold text-white">contact</h1>
  </MotionBox>
  <ul class="space-y-2 text-base">
    <li class={liClass}>
      <Icon name="mdi:email" class="text-xl" />
      e-mail:
      <Link href="mailto:filip.kasperski@proton.me" style={{ backgroundColor: COLORS.yellow }} className="px-2 py-0.5 my-0.5 text-black">
        filip.kasperski@proton.me
      </Link>
    </li>
    <li class={liClass}>
      <Icon name="mdi:github" class="text-xl" />
      github:
      <Link href="https://github.com/pilif139" style={{ backgroundColor: COLORS.green }} className="px-2 py-0.5 my-0.5 text-black"> pilif139 </Link>
    </li>
    <li class={liClass}>
      <Icon name="mdi:linkedin" class="text-xl" />
      linkedin: <Link href="https://www.linkedin.com/in/filip-kasperski-b80a8b310/" style={{ backgroundColor: COLORS.red }} className="px-2 py-0.5 my-0.5">
        Filip Kasperski
      </Link>
    </li>
  </ul>
</Layout>
