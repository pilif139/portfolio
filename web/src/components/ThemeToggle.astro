---
import { Icon } from "astro-icon/components";
---

<button
  id="theme-toggle"
  aria-label="Toggle dark mode"
  class="cursor-pointer p-1 text-foreground"
>
  <Icon name="mdi:weather-night" class="text-xl dark:hidden" />
  <Icon name="mdi:weather-sunny" class="hidden text-xl dark:block" />
</button>

<script>
  document.getElementById("theme-toggle")?.addEventListener("click", (e) => {
    const swap = () => {
      const dark = document.documentElement.classList.toggle("dark");
      localStorage.setItem("theme", dark ? "dark" : "light");
    };

    const doc = document as Document & {
      startViewTransition?: (cb: () => void) => void;
    };
    //not every browser supports view transitions, so fall back to immediate swap
    if (!doc.startViewTransition || matchMedia("(prefers-reduced-motion: reduce)").matches) {
      swap();
      return;
    }
    doc.startViewTransition(swap);
  });
</script>
