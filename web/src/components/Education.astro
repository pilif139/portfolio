---
import MotionBox from "@/components/ui/MotionBox";
import { COLORS } from "@/lib/colors";
---

<MotionBox client:load>
<section>
  <div style={{ backgroundColor: COLORS.green, rotate: "0.9deg" }} class="inline-block px-2 py-1 my-2">
    <h2 class="text-xl font-bold text-black">Education</h2>
  </div>
  <ul class="space-y-2 text-base">
    <li>
      <span class="text-heading font-bold">
        Zespół Szkół Komunikacji im. Hipolita Ciegielskiego, Poznań</span
      >
      <p class="font-medium">
        Software Development <span class="text-muted font-normal">
          — 2022–2027</span
        >
      </p>
      <p class="text-secondary">
        Currently pursuing a technical high school diploma. During my studies, I
        have been exposed to programming, web development, and computer science
        fundamentals. Gained practical experience in various programming
        languages and frameworks. Passed national INF.03 exam in 2024 with 100%
        score.
      </p>
    </li>
  </ul>
</section>
</MotionBox>
