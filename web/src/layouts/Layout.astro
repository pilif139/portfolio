---
import Link from "@/components/ui/Link";
import MotionBox from "@/components/ui/MotionBox";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { COLORS } from "@/lib/colors";

interface Props {
  title?: string;
}

const { title } = Astro.props;
const navbarLinks = [
  { label: "home", href: "/portfolio", color: COLORS.pink },
  { label: "contact", href: "/portfolio/contact", color: COLORS.teal },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/portfolio/favicon.svg" />
    <link rel="icon" href="/portfolio/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>pilif139 {title != null ? `- ${title}` : ""}</title>
    <script is:inline>
      const theme = localStorage.getItem("theme") ?? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      if (theme === "dark") document.documentElement.classList.add("dark");
    </script>
  </head>
  <body
    class="min-h-screen bg-background font-[Arial] text-foreground antialiased"
  >
    <div class="flex flex-col">
      <header class="bg-primary px-3 py-2">
        <nav class="mx-auto flex max-w-3xl text-xl font-medium items-baseline gap-4">
          {
            navbarLinks.map((link, i) => (
              <MotionBox client:load delay={i * 0.1} shake className="inline-block">
                <Link
                  href={link.href}
                  className="no-underline px-2 py-0.5 my-0.5 text-white inline-block"
                  style={{ backgroundColor: link.color }}
                >
                  {link.label}
                </Link>
              </MotionBox>
            ))
          }
          <ThemeToggle />
        </nav>
      </header>
    </div>
    <main class="mx-auto max-w-3xl py-6 pb-60">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
