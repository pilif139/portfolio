---
import Link from "@/components/ui/Link";

interface Props {
  title?: string;
}

const { title } = Astro.props;
const navbarLinks = [
  { label: "home", href: "/portfolio" },
  { label: "contact", href: "/portfolio/contact" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/portfolio/favicon.svg" />
    <link rel="icon" href="/portfolio/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>pilif139 {title != null ? `- ${title}` : ""}</title>
  </head>
  <body
    class="min-h-screen bg-background font-mono text-foreground antialiased"
  >
    <header class="bg-primary px-3 py-2">
      <nav class="mx-auto flex max-w-3xl items-baseline gap-4">
        {
          navbarLinks.map((link) => (
            <Link
              href={link.href}
              className="hover:underline no-underline"
            >
              {link.label}
            </Link>
          ))
        }
      </nav>
    </header>
    <main class="mx-auto max-w-3xl px-3 py-6 pb-60">
      <slot />
    </main>
  </body>
</html>

<script is:inline>
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const stars = [];
  const layer = document.createElement("div");
  layer.className = "starfield";
  document.body.appendChild(layer);

  for (let i = 0; i < 70; i++) {
    const s = document.createElement("span");
    s.className = "star";
    s.style.left = `${Math.random() * 100}%`;
    s.style.top = `${Math.random() * 100}%`;
    s.style.width = s.style.height = `${Math.random() < 0.7 ? 1 : 2}px`;
    s.style.animationDuration = `${5 + Math.random() * 3}s`;
    s.style.animationDelay = `${-Math.random() * 5}s`;
    layer.appendChild(s);
    stars.push(s);
  }

  if (!reduced) {
    setInterval(() => {
      const s = stars[Math.floor(Math.random() * stars.length)];
      s.style.left = `${Math.random() * 100}%`;
      s.style.top = `${Math.random() * 100}%`;
    }, 800);
  }
</script>

<style is:global>
  @import "../styles/global.css";
</style>
