---
import Link from "@/components/ui/Link";

interface Props {
  title?: string;
}

const { title } = Astro.props;
const navbarLinks = [
  { label: "home", href: "/" },
  { label: "contact", href: "/contact" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>pilif139 {title != null ? `- ${title}` : ""}</title>
  </head>
  <body
    class="min-h-screen bg-background font-mono text-foreground antialiased"
  >
    <header class="bg-primary px-3 py-2">
      <nav class="mx-auto flex max-w-3xl items-baseline gap-4">
        {
          navbarLinks.map((link) => (
            <Link
              href={link.href}
              className="hover:text-muted hover:underline no-underline"
            >
              {link.label}
            </Link>
          ))
        }
      </nav>
    </header>
    <main class="mx-auto max-w-3xl px-3 py-6 pb-60">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
